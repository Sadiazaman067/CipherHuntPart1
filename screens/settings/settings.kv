#:kivy 1.0
#:import utils kivy.utils

<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 30
        spacing: 15

        Label:
            text: "Settings"
            font_size: '30sp'

        Label:
            text: "Username"

        TextInput:
            id: username_input
            hint_text: "New username"
            multiline: False

        Label:
            text: "Email"

        TextInput:
            id: email_input
            hint_text: "you@example.com"
            multiline: False

        AppButton:
            id: save_button
            text: "Save Changes"

        Widget:

        Label:
            text: "Wiping your data will delete your account and clues."

        AppButton:
            id: wipe_button
            text: "Wipe My Data"